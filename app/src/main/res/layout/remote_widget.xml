<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@drawable/widget_shell">

    <LinearLayout
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/widget_header">
        <ImageView
            android:id="@+id/widget_device_icon"
            android:layout_width="22dp"
            android:layout_height="29dp"
            android:src="@drawable/ic_dap_hero"
            android:scaleType="centerInside"
            android:contentDescription="DAP" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="7dp">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DAP Remote"
                android:textColor="#F2F4F6"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="#9299A3"
                android:textSize="9sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Open DAP Remote" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">
        <ImageButton android:id="@+id/widget_prev" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:layout_marginEnd="3dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="9dp" android:background="@drawable/widget_circle" android:src="@drawable/ic_prev" android:scaleType="centerInside" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="46dp" android:layout_height="46dp" android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="11dp" android:background="@drawable/widget_circle_active" android:src="@drawable/ic_play_pause" android:scaleType="centerInside" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="3dp" android:layout_marginEnd="4dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="9dp" android:background="@drawable/widget_circle" android:src="@drawable/ic_next" android:scaleType="centerInside" android:contentDescription="Next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_panel">
        <ImageButton android:id="@+id/widget_down" android:layout_width="34dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:background="@drawable/widget_circle" android:src="@drawable/ic_minus" android:contentDescription="Volume down" />
        <TextView android:id="@+id/widget_mute" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="MUTE" android:textColor="#D7DCE2" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/widget_mute" />
        <ImageButton android:id="@+id/widget_up" android:layout_width="34dp" android:layout_height="34dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:background="@drawable/widget_circle" android:src="@drawable/ic_plus" android:contentDescription="Volume up" />
    </LinearLayout>
</LinearLayout>
